# syntax=docker/dockerfile:1
# SPDX-License-Identifier: Apache-2.0
FROM node:24.13.0-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV ONEVOICE_E2E=1
ENV ONEVOICE_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
ENV HOME=/root
ENV HYPERFRAMES_NO_TELEMETRY=1
ENV HYPERFRAMES_NO_UPDATE_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-dejavu-core \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxext6 \
    libxshmfence1 \
    libgtk-3-0 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@11.24.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN test ! -e .env && test ! -d references
RUN pnpm exec hyperframes browser ensure \
    && find /root/.cache/hyperframes/chrome -type f -name chrome-headless-shell | grep -q .
ENV HYPERFRAMES_NO_AUTO_INSTALL=1
ENV ONEVOICE_HYPERFRAMES_PATH=/app/node_modules/.bin/hyperframes
CMD ["sh", "-c", "pnpm typecheck && pnpm lint && pnpm exec vitest run --maxWorkers=1 --no-file-parallelism"]
