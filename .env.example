# Sao chép thành .env và đổi các giá trị trước khi chạy thật
POSTGRES_PASSWORD=opencorp_dev
KEYCLOAK_ADMIN_PASSWORD=admin_dev
CHATWOOT_SECRET=thay_bang_chuoi_ngau_nhien_dai_64_ky_tu

# --- LLM: gọi qua API chuẩn OpenAI-compatible (base URL + API key) ---
# Điền base URL và API key của nhà cung cấp bạn dùng (OpenAI, OpenRouter, Groq, DeepSeek...).
# Để trống LLM_API_KEY thì orchestrator tự rơi về Ollama local (profile local-llm) làm phao offline.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Phương án dự phòng offline (chỉ cần khi bật profile local-llm) ---
OLLAMA_MODEL=qwen2.5:3b
