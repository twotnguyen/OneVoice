# Sao chép thành .env và đổi các giá trị trước khi chạy thật
POSTGRES_PASSWORD=opencorp_dev
KEYCLOAK_ADMIN_PASSWORD=admin_dev
CHATWOOT_SECRET=thay_bang_chuoi_ngau_nhien_dai_64_ky_tu

# --- LLM cloud: bắt buộc gọi qua API (base URL + API key) ---
# OpenCorp không tải hoặc chạy model AI local. Đổi nhà cung cấp bằng ba biến dưới đây.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Provider dự phòng (tự chuyển sang khi provider chính lỗi/timeout) ---
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Phao demo offline: 1 = phân đoạn AI chạy bằng kịch bản cache trong fixtures/demo/ ---
DEMO_MODE=0
