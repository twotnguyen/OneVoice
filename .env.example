# Required Supabase configuration. Supabase recommends publishable/secret keys
# for new projects. The publishable key is intentionally public and must be
# protected by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Exact application origin for authentication CSRF checks. Production requires
# an explicit HTTPS origin without trailing slash; local dev defaults below.
ONEVOICE_APP_ORIGIN=http://localhost:3000

# Server-only secret. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional Prisma connections. OneVoice does not use Prisma yet. Add real
# values only when Prisma is introduced. Use transaction mode for the
# application and session mode for migrations.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Supabase Auth legacy aliases. The application currently uses the
# publishable/secret keys above. These legacy anon/service_role JWT keys and
# JWT secret are not read by OneVoice today.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# OpenCode Zen Responses API. Keep the API key server-only.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=your_opencode_zen_api_key_here
AI_MODEL=muse-spark-1.3-contributor-free

# Local video runtime. Relative paths resolve from the repository root.
ONEVOICE_ORGANIZATION_ID=a0000000-0000-0000-0000-000000000001
ONEVOICE_MEDIA_ROOT=renders
ONEVOICE_IMAGE_HOSTS=product.hstatic.net
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ONEVOICE_FONT_PATH=
ONEVOICE_HYPERFRAMES_PATH=hyperframes
ONEVOICE_SCRIPT_MODEL=
ONEVOICE_SCRIPT_TIMEOUT_MS=180000
ONEVOICE_RENDERER=template
ONEVOICE_TTS_ENDPOINT=http://localhost:8123
ONEVOICE_TTS_TIMEOUT_MS=60000
ONEVOICE_MUSIC_GAIN=0.35
ONEVOICE_TEMPLATES_ROOT=src/lib/video/template-pipeline/templates
ONEVOICE_AUDIO_ROOT=assets/audio
# File job queue root (worker transport). Defaults to <ONEVOICE_MEDIA_ROOT>/queue.
ONEVOICE_QUEUE_ROOT=
ONEVOICE_WORKER_ID=
ONEVOICE_WORKER_POLL_MS=1000
ONEVOICE_JOB_STALE_MS=600000

# Facebook ingress: server-only credentials; live setup evidence tracked in OV-051.
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=

# Optional verified Meta Page inbox URL (no access tokens, not a guaranteed PSID chat link).
# Leave blank for the Page/PSID instructions in the support UI.
FACEBOOK_INBOX_URL=

# Optional permitted public trend sources; JSON array, empty means unconfigured.
# Each: {"key":"source_name","kind":"mastodon_tags"|"rss_news","url":"https://...","ttlSeconds":86400}
# See src/lib/trends/PROVIDERS.md. No Facebook engagement metrics are provided.
ONEVOICE_TREND_SOURCES=[]
