# Supabase client configuration. The publishable key is intentionally public and
# must be protected by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secrets. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.your-ai-provider.example/v1
AI_API_KEY=replace_me
AI_MODEL=replace_me
